# 宿主参考工程常用可选环境变量。
# 只有部署在子路径或跨域结构下时才需要显式设置。

# 宿主对外访问前缀，例如部署到 https://example.com/asns/ 时填 /asns/
VITE_ASNS_BASE_PATH=/asns/
ASNS_BASE_PATH=/asns/

# 如需显式覆盖宿主内嵌的 EDC 地址，可设置为完整 URL 或同域路径
VITE_ASNS_EDC_APP_URL=/edc/

# 如需显式覆盖宿主回写业务后端的地址，可设置为完整 URL 或同域路径
VITE_ASNS_APP_API_BASE=/api

# 如需显式覆盖宿主自己的 host-api 前缀，可设置为完整 URL 或同域路径
VITE_ASNS_HOST_API_BASE=/asns
