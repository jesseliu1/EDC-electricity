# Copy to: ~/.config/systemd/user/asns-host.service
# Build with VITE_ASNS_BASE_PATH=/asns/, run with ASNS_BASE_PATH=/ because
# the current nginx rule strips /asns/ before proxying to port 3001.

[Unit]
Description=ASNS Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/openclaw/projects/EDC-electricity/docs/Ref/asns（ai-sensory-nervous-system）ai感知神經系統
Environment=HOME=/home/openclaw
Environment=NODE_ENV=production
Environment=ASNS_BASE_PATH=/
Environment=PORT=3001
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
