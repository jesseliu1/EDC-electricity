# Copy to: ~/.config/systemd/user/edc-backend.service
# This template matches the current EDC runtime copy on this server.

[Unit]
Description=EDC Backend (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/openclaw/edc-electricity-server
Environment=HOME=/home/openclaw
Environment=ASNS_DATABASE_URL=sqlite+aiosqlite:///./data/asns.db
ExecStart=/home/openclaw/edc-electricity-server/venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
